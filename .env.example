# Copiar este archivo a .env.local (desarrollo) y completar con las credenciales reales
# del proyecto de Supabase correspondiente (desarrollo, preview o producción).
# NUNCA commitear .env ni .env.local con credenciales reales.

# --- Base de datos (Supabase Postgres) ---
# Connection pooling (pgbouncer), usada en runtime por la app en Vercel/Next.js.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (sin pooler), usada solo para migraciones de Prisma.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres"

# --- Supabase Auth + Storage ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-key"
# Clave de servicio: solo se usa en el servidor (nunca expuesta al cliente), para operaciones
# administrativas puntuales que requieran bypass de RLS.
SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-key"

# --- IA (API de Gemini / Google AI Studio) ---
# Ver 15-ia.md y 03-arquitectura.md — se invoca siempre desde el servidor (lib/ia/cliente-ia.ts).
# Migrado desde Anthropic el 2026-08-02 (ver CLAUDE.md supuesto S6). Conseguir en
# https://aistudio.google.com/apikey.
GEMINI_API_KEY="placeholder-gemini-api-key"

# --- Email (resumen/digest de notificaciones — opcional) ---
# Ver 13-notificaciones.md sección 4. Si se omite, el envío de emails queda
# deshabilitado sin error (fallback silencioso, ver lib/servicios/digest-email.service.ts) —
# el canal in-app sigue funcionando igual. Conseguir en https://resend.com/api-keys.
RESEND_API_KEY=""
RESEND_EMAIL_REMITENTE="ATP CRM <notificaciones@tudominio.org>"

# --- Cron (Vercel) ---
# Secreto compartido para autenticar las invocaciones de app/api/cron/*
# (Vercel las firma con este valor en el header Authorization). Generar con
# `openssl rand -hex 32` y cargarlo igual en las variables de entorno de Vercel.
CRON_SECRET="placeholder-cron-secret"

# --- Aplicación ---
# URL pública de la app, usada para armar links en notificaciones por email.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
